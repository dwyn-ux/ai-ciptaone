# ========================================================
# AI Ciptaone Router - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Salin file ini menjadi '.env' dan sesuaikan nilainya.
# JANGAN PERNAH menyimpan secret asli ke version control (Git).

APP_ENV=development
DEBUG=false
SECRET_KEY=change-this-to-a-very-secure-random-64-character-hex-string

# ----------------- Session & Security -----------------
SESSION_COOKIE_NAME=ciptaone_session
SESSION_LIFETIME_SECONDS=604800
# Set True jika berjalan di produksi dengan HTTPS
SESSION_SECURE_COOKIE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://ciptaone.com

# ----------------- Database (Cloudflare D1 / SQLite) -----------------
# Pilihan DB_MODE:
# - 'sqlite': Mode lokal mandiri (berguna untuk pengujian, dev offline, zero-dependency)
# - 'worker': Mode produksi sesuai PRD (FastAPI memanggil Cloudflare Worker D1 Gateway via HTTPS)
DB_MODE=sqlite
SQLITE_PATH=./local_d1.sqlite3
D1_WORKER_URL=https://AI Ciptaone-d1-worker.your-subdomain.workers.dev
D1_SERVICE_TOKEN=your-random-generated-service-token-secret

# ----------------- Penyimpanan Bukti Pembayaran -----------------
# Direktori lokal privat untuk menyimpan upload bukti transfer (tidak diakses publik via URL)
PROOF_UPLOAD_DIR=./storage/proofs
MAX_PROOF_SIZE_BYTES=5242880

# ----------------- Top-up & Rekening Usaha -----------------
TOPUP_EXPIRY_MINUTES=120
CREDIT_PER_RUPIAH=1
MANUAL_BANK_NAME="BCA / Mandiri / BRI"
MANUAL_ACCOUNT_NO="1234567890"
MANUAL_ACCOUNT_HOLDER="AI Ciptaone Router"
MANUAL_QRIS_IMAGE_URL=""

# ----------------- Telegram Dual-Bot Architecture -----------------
# 1. BOT PEMBELIAN (Untuk Pelanggan: /beli, /saldo, /key, /help)
# Webhook URL: https://decomu.site/api/v1/webhooks/telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# 2. BOT LAPORAN & MONITORING (Khusus Admin: Notifikasi Uang Masuk & Laporan Keuangan)
# Webhook URL: https://decomu.site/api/v1/webhooks/telegram-report
# Catatan: Jika dikosongkan, notifikasi laporan akan otomatis dikirim lewat Bot 1.
TELEGRAM_REPORT_BOT_TOKEN=
TELEGRAM_REPORT_WEBHOOK_SECRET=

# Daftar User ID Telegram Admin yang diizinkan menerima laporan (pisahkan dengan koma)
# Dapatkan User ID Anda dari bot @userinfobot
TELEGRAM_ADMIN_IDS=
TELEGRAM_ADMIN_CHAT_ID=

# ----------------- Duitku Payment Gateway (Full Service) -----------------
# Dukungan QRIS, Virtual Account (BCA, Mandiri, BRI, BNI, Permata, CIMB), E-Wallet, Ritel
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_MODE=sandbox
DUITKU_CALLBACK_URL=https://ciptaone.com/api/v1/webhooks/duitku
DUITKU_RETURN_URL=https://ciptaone.com/dashboard
DUITKU_WEBHOOK_IP_WHITELIST=

# ----------------- DANA Dynamic QRIS Adapter (Tahap Lanjutan) -----------------
# Catatan: Integrasi resmi DANA membutuhkan verifikasi akun DANA Bisnis dan akses API resmi.
# Tetap set DANA_ENABLED=false sampai izin merchant resmi terverifikasi.
DANA_ENABLED=false
DANA_ENV=sandbox
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
DANA_MERCHANT_ID=
DANA_PUBLIC_KEY=
DANA_PRIVATE_KEY=

# ----------------- Upstream AI Provider API Keys -----------------
# Kunci ini dikunci permanen di server (.env) dan tidak pernah terekspos ke klien.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=

# ----------------- Perlindungan Finansial & Circuit Breaker -----------------
# Rem darurat otomatis: Batas total kredit pemakaian AI seluruh sistem per hari (00:00 UTC).
# Contoh: 500000 = Rp 500.000 / hari. Set 0 jika tidak ingin dibatasi.
MAX_DAILY_AI_CREDITS=500000

# ----------------- Rate Limiting -----------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_TOPUP_PER_MINUTE=5
