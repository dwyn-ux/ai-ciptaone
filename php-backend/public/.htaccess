# ========================================================
# AI Ciptaone Router - Apache / LiteSpeed .htaccess
# Handles API routing, React SPA fallback, SSE streaming,
# and HTTP security headers for cPanel shared hosting.
# ========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Disable gzip / mod_deflate buffering for real-time SSE streaming
    <IfModule mod_env.c>
        SetEnv no-gzip 1
    </IfModule>
    <IfModule LiteSpeed>
        RewriteRule .* - [E=nobuf:1]
    </IfModule>

    # 2. Block direct access to hidden files, sensitive extensions and directories
    RewriteRule ^\.(?!well-known) - [F]
    RewriteRule ^(config|storage|src|tests|migrations)/ - [F]
    RewriteRule \.(sqlite|sqlite3|db|env|sql|log|sh|bat)$ - [F]

    # 3. Route Backend API endpoints directly to PHP Front Controller
    RewriteRule ^(api/v1/.*|v1/.*|health/.*)$ index.php [QSA,L]

    # 4. If request is for existing static asset (JS, CSS, images, etc.), serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Fallback for React SPA client-side routes (if index.html is present in document root)
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # 6. Default fallback to PHP index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable Directory Browsing
Options -Indexes
