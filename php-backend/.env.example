# ========================================================
# DECOMU AI ROUTER (PHP) - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi '.env' dan sesuaikan nilainya.
# JANGAN PERNAH menyimpan secret asli ke version control (Git).
# ========================================================

APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-to-a-very-secure-random-64-character-hex-string

# ----------------- Session & Security -----------------
SESSION_COOKIE_NAME=decomu_session
SESSION_LIFETIME_SECONDS=604800
# Set True jika website sudah menggunakan HTTPS (direkomendasikan di cPanel dengan AutoSSL)
SESSION_SECURE_COOKIE=true
CORS_ORIGINS=https://decomu.site,http://localhost:5173

# ----------------- Database (cPanel MySQL / MariaDB) -----------------
# Pilihan DB_DRIVER:
# - 'mysql': Standar untuk shared hosting cPanel (MySQL 8.0+ atau MariaDB 10.4+)
# - 'sqlite': Mode lokal mandiri (berguna untuk pengujian unit & dev offline)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_decomu
DB_USER=cpaneluser_dbuser
DB_PASS=your_strong_database_password
DB_CHARSET=utf8mb4
SQLITE_PATH=./storage/local.sqlite3

# ----------------- Penyimpanan Bukti Pembayaran -----------------
# Direktori lokal privat di luar web root untuk menyimpan bukti transfer
PROOF_UPLOAD_DIR=./storage/proofs
MAX_PROOF_SIZE_BYTES=5242880

# ----------------- Top-up & Rekening Usaha -----------------
TOPUP_EXPIRY_MINUTES=120
CREDIT_PER_RUPIAH=1
MANUAL_BANK_NAME="BCA / Mandiri / BRI"
MANUAL_ACCOUNT_NO="1234567890"
MANUAL_ACCOUNT_HOLDER="Decomu AI Router"
MANUAL_QRIS_IMAGE_URL=""

# ----------------- Bot Telegram Admin -----------------
# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=
# Daftar User ID Telegram Admin yang diizinkan untuk verifikasi (pisahkan dengan koma)
# Dapatkan User ID Anda dari bot @userinfobot
TELEGRAM_ADMIN_IDS=
# Secret token untuk memvalidasi header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ----------------- DANA Dynamic QRIS Adapter (Tahap Lanjutan) -----------------
# Catatan: Integrasi DANA dinamis membutuhkan verifikasi merchant DANA Bisnis dan akses API resmi.
# Tetap set DANA_ENABLED=false sampai izin merchant resmi disetujui.
DANA_ENABLED=false
DANA_ENV=sandbox
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
DANA_MERCHANT_ID=
DANA_PUBLIC_KEY=
DANA_PRIVATE_KEY=

# ----------------- Upstream AI Provider API Keys -----------------
# Adapter komersial (OpenRouter / OpenAI) dinonaktifkan secara default di seed
# sampai syarat penggunaan komersial dan izin reselling diverifikasi.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ----------------- Rate Limiting -----------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_TOPUP_PER_MINUTE=5
