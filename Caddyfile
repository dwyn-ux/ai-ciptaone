# Caddyfile for AI Ciptaone Router on Oracle Always Free VM
# Replace 'ciptaone.com' with your registered domain or Oracle Public IP

ciptaone.com {
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API and OpenAI-compatible Gateway to FastAPI
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /v1/* {
        reverse_proxy backend:8000
    }

    handle /health/* {
        reverse_proxy backend:8000
    }

    # Frontend Static Files (Built Vite dist)
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
