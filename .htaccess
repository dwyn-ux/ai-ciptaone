# ========================================================
# AI Ciptaone Router - Root Apache / LiteSpeed .htaccess
# Protects sensitive files and routes to php-backend/public
# ========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Disable gzip / mod_deflate buffering for real-time SSE streaming
    <IfModule mod_env.c>
        SetEnv no-gzip 1
    </IfModule>
    <IfModule LiteSpeed>
        RewriteRule .* - [E=nobuf:1]
    </IfModule>

    # 2. Block direct access to hidden files, sensitive extensions and directories
    RewriteRule ^\.(?!well-known) - [F]
    RewriteRule ^(php-backend/(config|storage|src|tests|migrations)|\.git|migrations|backend|frontend)/ - [F]
    RewriteRule \.(sqlite|sqlite3|db|env|sql|log|sh|bat|md|yml|pub)$ - [F]

    # 3. Route Backend API endpoints directly to PHP Front Controller
    RewriteRule ^(api/v1/.*|v1/.*|health/.*)$ php-backend/public/index.php [QSA,L]

    # 4. Route admin.php
    RewriteRule ^admin\.php$ php-backend/public/admin.php [QSA,L]

    # 5. Route docs & openapi
    RewriteRule ^(docs|documentation)$ php-backend/public/docs.php [QSA,L]
    RewriteRule ^docs\.php$ php-backend/public/docs.php [QSA,L]
    RewriteRule ^openapi\.json$ php-backend/public/openapi.json [QSA,L]

    # 6. Route static frontend assets if requested directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 7. Route client-side SPA routes (dashboard, playground, api-keys, topup, history, login, register, landing)
    RewriteRule ^(dashboard|playground|api-keys|topup|history|login|register|landing)/?$ php-backend/public/index.php [QSA,L]

    # 8. Route root
    RewriteRule ^$ php-backend/public/index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable Directory Browsing
Options -Indexes
